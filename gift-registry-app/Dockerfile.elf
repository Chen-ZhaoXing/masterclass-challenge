# elf image — same codebase as the shop, different job.
#
# The elf applies migrations and rebuilds the catalog, then exits 0. It is
# the workload that must run to completion BEFORE the shop starts (i.e. as an
# initContainer).
#
# Build:  docker build -f Dockerfile.elf -t touching/elf:1.7.0 .
# (run from this directory, or: make docker)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv/registry

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd --create-home elfops \
    && chmod +x entrypoint-app.sh entrypoint-elf.sh \
    && chown -R elfops:elfops /srv
USER elfops

ENTRYPOINT ["sh", "/srv/registry/entrypoint-elf.sh"]
